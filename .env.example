# Real-time Translation Environment Variables

# Zoom RTMS Credentials (required)
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_WEBHOOK_PORT=8080
ZOOM_WEBHOOK_PATH=/webhook

# Deepgram API Key (required)
DEEPGRAM_API_KEY=your_deepgram_api_key
# nova-3 + language=multi enables multilingual code-switching (e.g. mixed
# Japanese/English speech). Use language=en (or your source language) with
# a mono-lingual model if the source audio is a single language.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
# 300ms + soft-finalize below empirically cuts avg end-to-end latency
# ~8s -> ~5s. Deepgram rejects utterance_end_ms below 1000ms (400 error).
DEEPGRAM_ENDPOINTING=300
DEEPGRAM_UTTERANCE_END_MS=1000
# Force-finalize continuous speech after this many seconds even without a
# natural pause (prevents indefinite stalls on long fluent utterances).
DEEPGRAM_MAX_INTERIM_DURATION=2.5
DEEPGRAM_INTERIM_RESULTS=true
DEEPGRAM_SMART_FORMAT=true
# DEEPGRAM_VAD_EVENTS=false
# Bias ASR toward DICTIONARY_PATH terms via Deepgram Keyterm Prompting
# (nova-3 models only) so domain terms are corrected at the transcription
# source instead of only being patched up later by the LLM.
DEEPGRAM_KEYTERMS_ENABLED=true
# Deepgram caps keyterm prompting at ~100 terms / 500 tokens per request.
DEEPGRAM_MAX_KEYTERMS=100

# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google AI API Key (required if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key

# OpenAI API Key (required if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key

# Model settings (optional)
# gemini-2.5-flash-lite (and the rest of the gemini-2.x family) return 404
# "no longer available to new users" as of 2026-07-23 -- confirmed via
# direct API test. gemini-3.1-flash-lite verified working through the real
# streaming + thinking_budget=0 path: ~730ms TTFT, comparable latency.
# IMPORTANT: Gemini free tier caps at ~20 requests/DAY PER MODEL (separate
# from the ~10-15 RPM burst limit) -- a real conversation will exhaust this
# in minutes. Use the paid tier for anything beyond short testing.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_BUDGET=0
OPENAI_MODEL=gpt-4o-mini

# Translation pacing
TRANSLATION_WORKERS=4
GEMINI_RPM_LIMIT=60
# Hard ceiling per translation call. google-genai's async streaming call
# has been observed to hang indefinitely with no error on rare occasions;
# this bounds the damage to one dropped segment instead of a stuck worker.
TRANSLATION_TIMEOUT=15.0

# Translation settings
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=ja
CONTEXT_WINDOW_SIZE=3
TRANSLATION_QUEUE_SIZE=10

# Dictionary (optional) - CSV file with domain-specific terminology
# Format: source_term,target_term,notes
DICTIONARY_PATH=dictionary.csv
# Above this many dictionary entries, stop dumping the full dictionary into
# the cached LLM system prompt and switch to per-request relevance-based
# retrieval instead, so prompt size/cache cost don't grow with the
# dictionary. Below it, the whole dictionary stays cached (and can help
# the LLM correct ASR errors on terms it can't literally substring-match).
DICTIONARY_DYNAMIC_THRESHOLD=80
# Max terms injected per request once in dynamic mode.
DICTIONARY_DYNAMIC_LIMIT=30

# Curated domain glossary packs (comma-separated, e.g.
# "machine_learning,particle_physics"), loaded from
# dictionaries/domains/<name>.csv before DICTIONARY_PATH (so
# DICTIONARY_PATH entries override same-named pack entries).
# DOMAIN_PACKS=machine_learning
# DOMAIN_PACKS_DIR=dictionaries/domains

# Auto-preload: point at a slide deck (.pdf/.pptx) or video file and it is
# automatically read for terminology at session start -- the same idea as a
# human interpreter reading slides before a talk (see
# src/real_time_translation/preload/). Extracted terms are supplementary:
# they never override a domain-pack or DICTIONARY_PATH entry for the same
# term. Results are cached under dictionaries/sessions/.cache/, so
# re-running against an unchanged file doesn't re-pay for the LLM call.
# PRELOAD_SOURCE=slides.pdf
# PRELOAD_MAX_TERMS=80

# RTMP / ffmpeg settings (microservices)
RTMP_URL=rtmp://nms:1935/live/zoom
FFMPEG_CHUNK_MS=20
FFMPEG_SAMPLE_RATE=16000
FFMPEG_CHANNELS=1

# WebSocket + translation service settings (microservices)
WS_PUBLISH_URL=http://ws:8000/publish
TRANSLATION_API_URL=http://gemini:8000/translate
ASR_SEND_INTERIM=true
TRANSLATE_INTERIM=false
ASR_PARTIAL_MIN_INTERVAL_MS=200
TRANSLATION_CONCURRENCY=2
HTTP_TIMEOUT=10

# Ngrok authentication token - get it from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Zoom Closed Caption (optional) - Get the caption URL from Zoom meeting
# See: https://support.zoom.com/hc/en/article?id=zm_kb&sysparm_article=KB0060372
# ZOOM_CAPTION_URL=https://wmcc.zoom.us/closedcaption?id=...
# ZOOM_CAPTION_LANG=ja